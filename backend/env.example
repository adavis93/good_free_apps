# ============================================================
# Good Free Apps — Document Chunker Backend
# Environment Variables
#
# Copy this file to .env for local development.
# On Railway: set these in the Variables tab in your dashboard.
# NEVER commit your actual .env file to git.
# ============================================================

# The origin(s) your frontend is served from.
# Railway/Netlify production example:
#   ALLOWED_ORIGINS=https://goodfreeapps.com
# Multiple origins (comma-separated):
#   ALLOWED_ORIGINS=https://goodfreeapps.com,https://www.goodfreeapps.com
# Local development with file:// protocol or Live Server:
#   ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,null
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,null

# HTTP port. Railway sets this automatically — don't change it in production.
# For local development, 8080 is a safe default.
PORT=8080

# Rate limiting: max requests per IP per 60-second window.
# 20 is a reasonable limit for a free tool. Lower if you see abuse.
MAX_REQUESTS_PER_MIN=20

# Logging level. Options: DEBUG, INFO, WARNING, ERROR
# Use DEBUG locally to see detailed request logs.
# Use INFO in production.
LOG_LEVEL=INFO

# Flask environment. Set to "development" locally to enable auto-reload.
# In production leave this unset or set to "production".
# FLASK_ENV=development
